{
  "name": "galius-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [{ "binding": "LEADS_KV" }],
  "observability": { "enabled": true }
}
